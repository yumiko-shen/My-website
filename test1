            ["旧金山", "国外", "intl_eng,intl,fast,modern,diverse,expensive", "金门大桥的雾气，科技与创新的心脏，极度包容且多元。", "科技从业者、追求前沿思想、喜欢起伏街道的人。", "满大街的流浪汉问题，房价物价令人咋舌。"],
            ["洛杉矶", "国外", "intl_eng,intl,medium_pace,sunny,drive,sea", "天使之城，永远的阳光加州，电影工业与造梦之地。", "喜欢阳光沙滩、有汽车代步、充满梦想的人。", "没有车等于没有腿，交通极其拥堵，城市平摊面积大。"],
            ["多伦多", "国外", "intl_eng,intl,fast,diverse,modern,cold", "北美最多元文化的城市，一半是繁华都市，一半是安大略湖。", "看重文化包容度、喜欢北美都市生活的人。", "冬天非常寒冷且漫长，常有暴风雪。"],
            ["马德里", "国外", "intl_other,intl,medium_pace,sunny,street_food,history", "热情洋溢的伊比利亚中心，夜生活丰富，Tapas吃不停。", "性格开朗、喜欢阳光和夜生活、享受美食的人。", "夏天极热，午休文化（Siesta）导致下午办事不便。"],
            ["大阪", "国外", "intl_other,intl,fast,street_food,noisy,convenient", "关西的厨房，充满人情味和幽默感，比东京更随性热闹。", "吃货、喜欢热闹吐槽、觉得东京太压抑的人。", "城市卫生和秩序相比东京略逊一筹，夏天一样闷热。"]
        ];

        // 将数组格式的城市数据转换为对象数组
        const cities = rawCities.map(c => ({
            name: c[0],
            loc: c[1],
            tags: c[2].split(','),
            highlight: c[3],
            target: c[4],
            flaw: c[5]
        }));

        // --- 应用状态与逻辑 ---
        
        const app = document.getElementById('app');
        let currentStep = 0; // 0 = 封面, 1~15 = 答题, 16 = 结果
        let userAnswers = []; // 记录用户每道题的选项tags

        // 渲染页面
        function render() {
            app.innerHTML = '';
            
            if (currentStep === 0) {
                renderStart();
            } else if (currentStep > 0 && currentStep <= questions.length) {
                renderQuestion(currentStep - 1);
            } else {
                renderResult();
            }
        }

        // 封面页
        function renderStart() {
            const html = `
                <div class="fade-in flex flex-col items-center justify-center h-full pt-10 text-center">
                    <div class="w-24 h-24 mb-6 rounded-full bg-morandi-light flex items-center justify-center shadow-sm">
                        <span class="text-4xl">✈️</span>
                    </div>
                    <h2 class="text-2xl font-semibold text-morandi-text mb-4">测测你的本命定居城市</h2>
                    <p class="text-morandi-subtext mb-10 px-4 leading-relaxed text-sm">
                        你究竟适合慢节奏的烟火古城，<br>还是繁华摩登的国际大都市？<br>15道题，抛开玄学，从真实生活需求出发，<br>找到那座写着你名字的城市。
                    </p>
                    <button onclick="nextStep()" class="bg-morandi-primary hover:bg-morandi-hover text-white font-medium py-3 px-12 rounded-full shadow-md transition-all active:scale-95">
                        开始测试
                    </button>
                    <p class="mt-6 text-xs text-morandi-border/60">小红书风极简测试 · 全50城数据库</p>
                </div>
            `;
            app.innerHTML = html;
        }

        // 答题页
        function renderQuestion(index) {
            const q = questions[index];
            
            let optionsHtml = '';
            q.options.forEach((opt, i) => {
                // 点击选项直接触发下一题，传递tags
                optionsHtml += `
                    <button onclick="selectOption('${opt.tags.join(',')}')" 
                        class="option-btn w-full text-left p-5 mb-4 rounded-2xl border-2 border-morandi-border bg-white text-morandi-text hover:border-morandi-primary transition-all shadow-sm">
                        ${opt.text}
                    </button>
                `;
            });

            const html = `
                <div class="fade-in flex flex-col h-full mt-4">
                    <div class="flex justify-between items-center mb-6 text-sm text-morandi-subtext font-medium">
                        <span class="tracking-wide">Q${index + 1}</span>
                        <span>${index + 1} / ${questions.length}</span>
                    </div>
                    
                    <!-- 进度条 -->
                    <div class="w-full bg-morandi-border/50 h-1.5 rounded-full mb-8">
                        <div class="bg-morandi-primary h-1.5 rounded-full transition-all duration-300" style="width: ${((index + 1) / questions.length) * 100}%"></div>
                    </div>

                    <h3 class="text-xl font-medium text-morandi-text mb-8 leading-snug">${q.question}</h3>
                    
                    <div class="flex-1 flex flex-col">
                        ${optionsHtml}
                        <button onclick="prevStep()" class="mt-2 mb-6 w-full bg-transparent border-2 border-morandi-border text-morandi-subtext hover:bg-white hover:border-morandi-subtext hover:text-morandi-text font-medium py-3.5 rounded-2xl transition-all active:scale-95">
                            ${index === 0 ? '返回首页' : '返回上一题'}
                        </button>
                    </div>
                </div>
            `;
            app.innerHTML = html;
        }

        // 选择选项并进入下一步
        window.selectOption = function(tagsStr) {
            if(tagsStr) {
                userAnswers[currentStep - 1] = tagsStr.split(',');
            }
            setTimeout(() => {
                nextStep();
            }, 150); // 微小的延迟，让用户看到点击反馈
        }

        window.prevStep = function() {
            if (currentStep > 0) {
                currentStep--;
                render();
            }
        }

        function nextStep() {
            currentStep++;
            render();
        }

        function reset() {
            currentStep = 0;
            userAnswers = [];
            render();
        }

        // 计算结果
        function calculateResult() {
            // 统计用户tag频率
            let tagCounts = {};
            // 将所有答题结果展平
            const allTags = userAnswers.flat().filter(Boolean);
            allTags.forEach(tag => {
                tagCounts[tag] = (tagCounts[tag] || 0) + 1;
            });

            let bestCity = null;
            let maxScore = -1;

            // 特殊强过滤逻辑 (Q12的国内/国外选择)
            const isDomesticOnly = tagCounts['cn_only'] > 0;
            const isIntlEng = tagCounts['intl_eng'] > 0;
            const isIntlOther = tagCounts['intl_other'] > 0;
            
            cities.forEach(city => {
                let score = 0;
                
                // 计算重合度得分
                city.tags.forEach(tag => {
                    if (tagCounts[tag]) {
                        score += tagCounts[tag];
                    }
                });

                // 应用强过滤权重
                if (isDomesticOnly && city.loc === '国内') score += 10;
                if ((isIntlEng || isIntlOther) && city.loc === '国外') score += 10;
                // 如果想要英语区，给带有intl_eng的城市加分
                if (isIntlEng && city.tags.includes('intl_eng')) score += 5;
                if (isIntlOther && city.tags.includes('intl_other')) score += 5;

                // 记录最高分
                if (score > maxScore) {
                    maxScore = score;
                    bestCity = city;
                }
            });

            // 兜底防错
            return bestCity || cities[0];
        }

        // 结果页
        function renderResult() {
            const city = calculateResult();
            
            const html = `
                <div class="fade-in flex flex-col items-center pt-2 pb-6">
                    <p class="text-xs text-morandi-subtext mb-2">经过灵魂匹配，你的本命定居地是</p>
                    <h2 class="text-4xl font-bold text-morandi-text mb-1 tracking-wider">${city.name}</h2>
                    <p class="text-sm px-3 py-1 bg-morandi-tag text-morandi-tagText rounded-full mb-8 font-medium">
                        ${city.loc}城市
                    </p>

                    <div class="w-full bg-white rounded-3xl p-6 shadow-sm border border-morandi-border mb-8 relative overflow-hidden">
                        <!-- 装饰用的小圆圈 -->
                        <div class="absolute -right-4 -top-4 w-16 h-16 bg-morandi-bg rounded-full opacity-50"></div>
                        
                        <div class="mb-5 relative z-10">
                            <h4 class="text-sm font-bold text-morandi-text mb-2 flex items-center">
                                <span class="mr-2">✨</span> 宜居亮点
                            </h4>
                            <p class="text-sm text-morandi-text/90 leading-relaxed bg-morandi-bg/50 p-3 rounded-xl">
                                ${city.highlight}
                            </p>
                        </div>
                        
                        <div class="mb-5 relative z-10">
                            <h4 class="text-sm font-bold text-morandi-text mb-2 flex items-center">
                                <span class="mr-2">🧍‍♀️</span> 适合人群
                            </h4>
                            <p class="text-sm text-morandi-text/90 leading-relaxed bg-morandi-bg/50 p-3 rounded-xl">
                                ${city.target}
                            </p>
                        </div>
                        
                        <div class="relative z-10">
                            <h4 class="text-sm font-bold text-morandi-text mb-2 flex items-center">
                                <span class="mr-2">☁️</span> 小小吐槽
                            </h4>
                            <p class="text-sm text-morandi-text/90 leading-relaxed bg-morandi-bg/50 p-3 rounded-xl">
                                ${city.flaw}
                            </p>
                        </div>
                    </div>

                    <div class="flex flex-col w-full gap-3">
                        <button onclick="alert('截图功能受浏览器限制，请直接长按屏幕或使用手机自带截图功能分享哦～')" class="w-full bg-morandi-primary hover:bg-morandi-hover text-white font-medium py-3.5 rounded-2xl shadow-sm transition-all active:scale-95">
                            截图保存，发小红书
                        </button>
                        <button onclick="reset()" class="w-full bg-white border border-morandi-border text-morandi-subtext font-medium py-3.5 rounded-2xl shadow-sm transition-all active:scale-95">
                            重新测试
                        </button>
                    </div>
                </div>
            `;
            app.innerHTML = html;
        }

        // 初始化加载
        window.onload = () => {
            render();
        };

    </script>
</body>
